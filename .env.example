# PartyPost has zero required env vars.
# Per-party config (sheet URL + slug) lives in src/config/parties.ts.
# Email confirmations are sent by Apps Script via your Gmail account.

# Optional: set this on Vercel so the magic edit link in confirmation emails
# uses the right host. Apps Script doesn't need it; only used in <a> tags
# rendered by the frontend if you ever add prod-only links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
