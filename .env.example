# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ----- Supabase -----
# From Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-side only. Bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ----- Admin allowlist (optional safety net) -----
# Comma-separated list of emails allowed to create/manage parties.
# Leave blank to allow any signed-in Google account.
ADMIN_EMAIL_ALLOWLIST=amyleerobinson@gmail.com

# ----- Resend (Phase 2 emails) -----
# Get from resend.com -> API Keys
RESEND_API_KEY=re_...
# From-address for confirmations. Use onboarding@resend.dev for dev, or your verified domain.
RESEND_FROM_EMAIL=PartyPost <onboarding@resend.dev>

# ----- App -----
# Public site URL (used for edit links in emails). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
